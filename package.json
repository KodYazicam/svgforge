{
  "name": "@kodyazicam/svgforge",
  "version": "2.5.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Generate GitHub README SVGs locally. 32 card types, 22 themes, no third-party render service.",
  "keywords": [
    "svg",
    "readme",
    "github",
    "github-readme",
    "readme-generator",
    "svg-generator",
    "badge",
    "card",
    "cli",
    "banner",
    "donut",
    "chart",
    "wave"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Batuhan (KodYazicam) <https://github.com/KodYazicam>",
  "homepage": "https://github.com/KodYazicam/svgforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/KodYazicam/svgforge.git"
  },
  "bugs": {
    "url": "https://github.com/KodYazicam/svgforge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "svgforge": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "ALL-SVG-FORMS.md",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck",
    "examples": "node dist/cli.js render examples/demo.json -o examples/",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
